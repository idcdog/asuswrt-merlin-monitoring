# Router SSH connection
ROUTER_HOST=192.168.1.1
ROUTER_PORT=2222
ROUTER_USER=root
SSH_TIMEOUT=20

# Live exporter
COLLECTION_INTERVAL=30
LISTEN_HOST=127.0.0.1
LISTEN_PORT=9101

# Unauthenticated device-name manager. Keep loopback unless the LAN is trusted.
MANAGEMENT_LISTEN_HOST=127.0.0.1
MANAGEMENT_LISTEN_PORT=9102

# Traffic Analyzer importer
VM_IMPORT_URL=http://127.0.0.1:8428/api/v1/import/prometheus
DEVICE_LABEL=ASUS-Router

# Read-only preflight endpoint checks
VICTORIAMETRICS_URL=http://127.0.0.1:8428
GRAFANA_URL=http://127.0.0.1:3000
SNMP_EXPORTER_URL=http://127.0.0.1:9116
BLACKBOX_EXPORTER_URL=http://127.0.0.1:9115
SNMP_AUTH=asus_router_v2
